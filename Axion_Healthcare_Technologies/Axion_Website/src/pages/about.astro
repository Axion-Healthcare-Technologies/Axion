---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal";
import ContactButton from "../components/ContactButton.astro";
import { site, contactHref } from "../data/site";
const a = site.about;
---
<Base title={a.seo.title} description={a.seo.description}>
  <Header />
  <main id="main">
    <section class="mx-auto max-w-7xl px-5 pb-20 pt-16 sm:px-8 sm:pb-28 sm:pt-28">
      <h1 class="font-display text-[clamp(2.4rem,7.5vw,6.5rem)] font-semibold leading-[1] tracking-[-0.035em]">
        {a.heading.map((l, i) => (
          <span class="block overflow-hidden pb-[0.08em]"><span class="rise block" style={`animation-delay:${i * 120}ms`}>{l}</span></span>
        ))}
      </h1>
      <p class="settle mt-10 max-w-xl text-lg leading-relaxed text-mute">{a.intro}</p>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32">
      <div class="grid gap-10 border-t border-ink/10 pt-16 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-16">
        <h2 class="font-display text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">{a.story.heading}</h2>
        <div class="max-w-xl space-y-5 text-lg leading-relaxed text-mute">
          {a.story.text.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32">
      <Reveal client:visible>
        <div data-reveal-item class="grid gap-px overflow-hidden rounded-[28px] bg-paper/15 md:grid-cols-2">
          {[a.mission.mission, a.mission.vision].map((m) => (
            <div class="bg-ink px-7 py-14 text-paper sm:px-12 sm:py-20">
              <h2 class="font-display text-2xl tracking-tight text-paper/60">{m.title}</h2>
              <p class="mt-5 font-display text-2xl leading-snug tracking-tight sm:text-4xl">{m.text}</p>
            </div>
          ))}
        </div>
      </Reveal>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-5xl">{a.values.heading}</h2>
      <dl class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {a.values.items.map((v) => (
          <div class="border-t border-ink/10 pt-6">
            <dt class="font-display text-2xl font-semibold tracking-tight">{v.title}</dt>
            <dd class="mt-3 max-w-md text-mute">{v.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="border-t border-ink/10 bg-white/60">
      <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
        <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{a.serve.heading}</h2>
        <ul class="mt-10 flex flex-wrap gap-3">
          {a.serve.items.map((s) => <li class="rounded-full border border-ink/15 bg-white px-5 py-2.5 text-[15px]">{s}</li>)}
        </ul>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32">
      <Reveal client:visible>
        <div data-reveal-item class="rounded-[28px] bg-ink px-7 py-20 text-paper sm:px-16 sm:py-28">
          <h2 class="max-w-3xl font-display text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">{a.cta.heading}</h2>
          <p class="mt-6 max-w-lg text-paper/70">{a.cta.text}</p>
          <ContactButton variant="light" label={a.cta.button} class="mt-10" />
          <p class="mt-6 text-sm text-paper/60 [overflow-wrap:anywhere]">{a.cta.emailPrefix} <a href={contactHref} class="font-medium text-paper underline decoration-paper/40 underline-offset-4 transition-colors hover:decoration-paper">{site.contact.email}</a></p>
        </div>
      </Reveal>
    </section>
  </main>
  <Footer />
  <ContactButton variant="floating" />
</Base>
