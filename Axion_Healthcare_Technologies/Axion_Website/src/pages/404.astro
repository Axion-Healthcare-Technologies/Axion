---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import ContactButton from "../components/ContactButton.astro";
---
<Base title="Page not found — Axion Healthcare Technologies" description="This page could not be found.">
  <Header />
  <main class="mx-auto max-w-7xl px-5 py-32 sm:px-8">
    <h1 class="font-display text-5xl font-semibold tracking-tight sm:text-7xl">Page not found.</h1>
    <p class="mt-6 text-mute">The page you’re looking for doesn’t exist.</p>
    <a href="/" class="mt-8 inline-block border-b border-ink pb-0.5 text-sm font-medium hover:border-accent hover:text-accent">Back to home →</a>
  </main>
  <ContactButton variant="floating" />
</Base>
