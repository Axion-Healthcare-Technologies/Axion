---
import Reveal from "./Reveal";
import { site } from "../data/site";
const { process: p } = site;
---
<section class="border-t border-ink/10">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32">
    <Reveal client:visible>
      <h2 data-reveal-item class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">{p.heading}</h2>
      <ol class="mt-14 grid gap-10 md:grid-cols-4">
        {p.steps.map((s, i) => (
          <li data-reveal-item>
            <span class="font-display text-sm text-accent">0{i + 1}</span>
            <div class="mt-3 h-px bg-ink/20"></div>
            <h3 class="mt-5 font-display text-2xl tracking-tight">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-mute">{s.text}</p>
          </li>
        ))}
      </ol>
    </Reveal>
  </div>
</section>
