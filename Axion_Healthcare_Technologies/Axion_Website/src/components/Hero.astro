---
import ContactButton from "./ContactButton.astro";
import { site } from "../data/site";
const { hero } = site;
---
<section class="mx-auto max-w-7xl px-5 pb-24 pt-20 sm:px-8 sm:pb-32 sm:pt-32">
  <p class="settle mb-8 inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>{hero.eyebrow}</p>
  <h1 class="font-display text-[clamp(2.6rem,8vw,7rem)] font-semibold leading-[1] tracking-[-0.035em]">
    {hero.lines.map((l, i) => (
      <span class="block overflow-hidden pb-[0.08em]"><span class="rise block" style={`animation-delay:${i * 120}ms`}>{l}</span></span>
    ))}
  </h1>
  <div class="settle mt-10 grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
    <p class="max-w-lg text-lg leading-relaxed text-mute">{hero.text}</p>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <ContactButton label={hero.primary} />
      <a href="#solutions" class="px-2 py-3 text-[15px] font-medium underline decoration-ink/30 underline-offset-8 transition-colors hover:text-accent hover:decoration-accent">{hero.secondary}</a>
    </div>
  </div>
  <a href={hero.proof.href} class="settle group mt-12 inline-flex max-w-full items-center gap-3 rounded-full border border-ink/10 bg-white py-2 pl-2 pr-5 text-sm shadow-[0_12px_30px_-22px_rgba(11,27,51,.5)] transition hover:border-accent/40">
    <span class="flex items-center gap-1.5 rounded-full bg-accent/10 px-3 py-1 font-medium text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>{hero.proof.prefix}</span>
    <span class="truncate text-mute">{hero.proof.label}</span>
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
  </a>
</section>
