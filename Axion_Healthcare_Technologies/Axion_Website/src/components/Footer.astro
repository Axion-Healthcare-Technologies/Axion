---
import Logo from "./Logo.astro";
import { site, contactHref } from "../data/site";
const c = site.contact;
const socials = [
  { label: "LinkedIn", href: site.social.linkedin, path: "M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" },
  { label: "Facebook", href: site.social.facebook, path: "M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.97.93-1.97 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z" },
].filter((s) => s.href);
---
<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 pb-10 pt-12 sm:px-8 md:flex-row md:items-start md:justify-between">
    <div>
      <Logo size="h-11" text="text-[2.1rem]" sub="text-[10px]" />
      <p class="mt-2 max-w-xs text-sm text-mute">{site.footer.tagline}</p>
      <nav aria-label="Footer" class="mt-4 flex gap-5 text-sm font-medium">
        {site.nav.links.map((l) => <a href={l.href} class="transition-colors hover:text-accent">{l.label}</a>)}
      </nav>
    </div>
    <div class="flex flex-col gap-3 text-sm md:items-end">
      <a class="font-medium transition-colors hover:text-accent" href={contactHref}>{c.email}</a>
      {c.phone && <a class="font-medium transition-colors hover:text-accent" href={`tel:${c.phone.replace(/\s/g, "")}`}>{c.phone}</a>}
      {c.address && <p class="max-w-xs text-mute md:text-right">{c.address}</p>}
      {socials.length > 0 && (
        <div class="flex flex-wrap items-center gap-3">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${site.short} on ${s.label}`} class="inline-flex items-center gap-2 rounded-full border border-ink bg-ink px-4 py-2 text-sm font-medium text-white transition-colors hover:border-accent hover:bg-accent">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
              <span>{s.label}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
  <div class="mx-auto max-w-7xl border-t border-ink/10 px-5 pb-24 pt-6 text-xs leading-relaxed text-mute sm:px-8">
    <p class="max-w-3xl">{site.footer.disclaimer}</p>
    <p class="mt-2">{site.footer.copyright}</p>
  </div>
</footer>
