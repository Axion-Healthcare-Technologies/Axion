---
import Logo from "./Logo.astro";
import { site, contactHref } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-6 sm:px-8">
  <Logo />
  <nav aria-label="Main" class="flex items-center gap-4 text-sm font-medium sm:gap-8">
    {site.nav.links.map((l) => (
      <a href={l.href} aria-current={path === l.href ? "page" : undefined}
         class="py-2 transition-colors hover:text-accent aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:underline-offset-8">{l.label}</a>
    ))}
    <a href={contactHref} class="hidden rounded-full bg-accent px-5 py-2.5 text-white transition-colors hover:bg-ink sm:inline-block">{site.nav.cta}</a>
  </nav>
</header>
